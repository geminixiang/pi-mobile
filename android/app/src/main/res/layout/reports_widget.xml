<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/reports_widget_background"
    android:clipToOutline="true">

    <LinearLayout
        android:id="@+id/report"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/report_avatar"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/reports_widget_avatar"
                android:clipToOutline="true"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/report_bot"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_text"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/report_when"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/report_next"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="@drawable/reports_widget_next"
                android:gravity="center"
                android:minWidth="84dp"
                android:paddingHorizontal="16dp"
                android:textColor="@color/widget_text"
                android:textSize="16sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/report_headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/widget_text"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/report_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:lineSpacingExtra="2dp"
            android:maxLines="2"
            android:textColor="@color/widget_muted"
            android:textSize="14sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/reports_room"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/reports_empty"
        android:scaleType="fitCenter"
        android:visibility="gone" />
</FrameLayout>
