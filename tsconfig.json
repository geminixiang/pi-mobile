{
	"compilerOptions": {
		"target": "es2024",
		"module": "esnext",
		"moduleResolution": "bundler",
		"lib": [
			"es2024",
			"dom",
			"dom.iterable"
		],
		"strict": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"skipLibCheck": true,
		"verbatimModuleSyntax": true,
		"jsx": "react-jsx"
	},
	"include": [
		"src",
		"test",
		"vite.config.ts"
	]
}
