[Unit]
Description=pi sandbox relay (WebSocket to per-conversation pi-env containers)
After=docker.service
Requires=docker.service

[Service]
WorkingDirectory=%h/pi-sandbox/relay
EnvironmentFile=%h/.config/pi-sandbox/env
Environment=DOCKER_HOST=unix://%t/docker.sock
ExecStart=/usr/bin/node server.mjs
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
